VITE_API_URL=http://localhost:3000
# Live notifications: auto (default) = Socket.IO in dev, HTTP polling in production (Vercel).
# Set polling explicitly on Vercel: VITE_REALTIME_MODE=polling
# For a long-running API with WebSockets: VITE_REALTIME_MODE=socket and VITE_WS_URL=https://your-api.example.com
# VITE_REALTIME_MODE=auto
# VITE_WS_URL=http://localhost:3000
# Same App ID as ONESIGNAL_APP_ID in the backend (.env)
VITE_ONESIGNAL_APP_ID=
